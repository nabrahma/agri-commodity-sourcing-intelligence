# Secrets - never commit
.env
.env.*
!.env.example

# Data artefacts - regenerated by the pipeline, not source.
data/**
!data/**/
!data/**/.gitkeep

# ... except the materialised outputs the dashboard reads. These are small
# aggregates (~250 KB total), they are the actual result of the pipeline
# rather than a sample of it, and committing them is what lets the hosted
# dashboard show real numbers. The 25 MB raw landing zone stays out: it is
# reproducible with `make backfill-history`.
!data/processed/analytics/*.parquet
!data/processed/simulation/*.parquet
!data/processed/simulation/*.json

# The daily pull accrues here, roughly 75 KB a day. Committing it is the
# only persistence this project has, and it is how history builds forward
# from the point the archive stops. The bulk 2019-2023 backfill
# (source=backfill, 25 MB) is never committed.
!data/raw/source=api/**/*.parquet
*.duckdb
*.duckdb.wal

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Tooling
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Internal planning document, not part of the deliverable
build-spec.md
